#!/bin/sh
# Telemt WEB managed NGINX frontend helper.
# Owns only /etc/nginx/conf.d/telemt-web.conf; never rewrites /etc/config/nginx
# or the OpenWrt-generated main nginx configuration.

. /lib/functions.sh

NGINX_BIN=/usr/sbin/nginx
NGINX_UTIL=/usr/bin/nginx-util
NGINX_INIT=/etc/init.d/nginx
FRAGMENT=/etc/nginx/conf.d/telemt-web.conf
FRAGMENT_BACKUP=/etc/nginx/conf.d/telemt-web.conf.telemt-backup
LOCKDIR=/tmp/telemt-web-nginx.lock
MARKER='# TELEMT-MANAGED-NGINX v1'

log() { printf '%s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

is_uint() {
    [ -n "$1" ] && echo "$1" | grep -qE '^[0-9]+$'
}

load_config() {
    config_load telemt
    config_get_bool web_enabled web enabled 0
    config_get tls_terminator web tls_terminator external
    config_get_bool nginx_managed web nginx_managed 0
    config_get nginx_bind web nginx_bind '443'
    config_get_bool nginx_ipv6 web nginx_ipv6 0
    config_get nginx_cert web nginx_cert ''
    config_get nginx_key web nginx_key ''
    config_get_bool nginx_auto_fw web nginx_auto_fw 1
    config_get_bool web_listener_enabled web_listener enabled 1
    config_get web_ip web_listener ip '127.0.0.1'
    config_get web_port web_listener port '27453'

    web_hosts=''
    web_host_count=0
    web_host_error=0
    trusted_loopback=0

    collect_host() {
        local s="$1" en host
        config_get_bool en "$s" enabled 1
        [ "$en" -eq 1 ] || return 0
        config_get host "$s" host ''
        if ! echo "$host" | grep -qE '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' || ! echo "$host" | grep -q '\.'; then
            printf "ERROR: enabled WEB vhost '%s' has invalid FQDN '%s'\n" "$s" "$host" >&2
            web_host_error=1
            return 0
        fi
        host=$(echo "$host" | tr 'A-Z' 'a-z')
        web_hosts="${web_hosts} ${host}"
        web_host_count=$((web_host_count + 1))
    }

    check_trusted_proxy() {
        [ "$1" = '127.0.0.1/32' ] && trusted_loopback=1
    }

    config_foreach collect_host web_vhost
    config_list_foreach web_listener trusted_proxy_cidr check_trusted_proxy
}

require_nginx_ssl() {
    [ -x "$NGINX_BIN" ] || die "OpenWrt SSL-capable NGINX is not installed"
    [ -x "$NGINX_UTIL" ] || die "nginx-util is missing; use the standard OpenWrt nginx-ssl/nginx-full package"
    [ -x "$NGINX_INIT" ] || die '/etc/init.d/nginx is missing'
    "$NGINX_BIN" -V 2>&1 | grep -q -- '--with-http_ssl_module' || \
        die 'installed NGINX has no HTTP SSL module'
    if "$NGINX_BIN" -V 2>&1 | grep -q -- '--without-http_proxy_module'; then
        die 'installed NGINX has no HTTP proxy module'
    fi
}

validate_frontend_config() {
    [ "$web_enabled" -eq 1 ] || die 'telemt.web.enabled must be 1'
    [ "$tls_terminator" = 'nginx' ] || die "telemt.web.tls_terminator must be 'nginx'"
    [ "$web_listener_enabled" -eq 1 ] || die 'WEB backend listener is disabled'
    [ "$web_ip" = '127.0.0.1' ] || die 'managed NGINX requires WEB backend on 127.0.0.1'
    is_uint "$web_port" && [ "$web_port" -ge 1 ] && [ "$web_port" -le 65535 ] || \
        die "invalid WEB backend port '$web_port'"
    [ "$trusted_loopback" -eq 1 ] || die 'web_listener must trust 127.0.0.1/32 for managed NGINX'
    [ "$web_host_error" -eq 0 ] || die 'one or more enabled WEB vhosts are invalid'
    [ "$web_host_count" -gt 0 ] || die 'at least one enabled WEB vhost with a valid FQDN is required'

    echo "$nginx_bind" | grep -qE '^443$|^0\.0\.0\.0:443$|^([0-9]{1,3}\.){3}[0-9]{1,3}:443$' || \
        die "nginx_bind must be 443 or an IPv4 address on :443"

    [ -n "$nginx_cert" ] || die 'nginx_cert is empty'
    [ -n "$nginx_key" ] || die 'nginx_key is empty'
    echo "$nginx_cert" | grep -qE '^/[A-Za-z0-9._/@+-]+$' || die 'nginx_cert contains unsupported path characters'
    echo "$nginx_key" | grep -qE '^/[A-Za-z0-9._/@+-]+$' || die 'nginx_key contains unsupported path characters'
    [ -f "$nginx_cert" ] || die "certificate file not found: $nginx_cert"
    [ -f "$nginx_key" ] || die "private key file not found: $nginx_key"
}

check_bind_conflict() {
    local lines='' other=''
    if command -v ss >/dev/null 2>&1; then
        lines=$(ss -lntp 2>/dev/null | grep -E '(:|\])443[[:space:]]' || true)
    elif command -v netstat >/dev/null 2>&1; then
        lines=$(netstat -lntp 2>/dev/null | grep -E '(:|\])443[[:space:]]' || true)
    fi
    [ -z "$lines" ] && return 0
    other=$(printf '%s\n' "$lines" | grep -vi nginx || true)
    [ -z "$other" ] && return 0
    printf '%s\n' "$other" >&2
    die 'TCP/443 is already occupied by a non-NGINX listener; resolve uhttpd/HAProxy/other conflict first'
}

render_cfg() {
    local out="$1"
    umask 077
    {
        printf '%s\n' "$MARKER"
        printf '%s\n' '# Generated from /etc/config/telemt. Do not edit this file in managed mode.'
        printf '%s\n' '# Included by the standard OpenWrt nginx conf.d/*.conf hook inside http {}.'
        cat <<'EOF'
map $http_upgrade $telemt_connection_upgrade {
    default upgrade;
    ''      '';
}

upstream telemt_web_managed {
EOF
        printf '    server %s:%s;\n' "$web_ip" "$web_port"
        cat <<'EOF'
    keepalive 64;
}

server {
EOF
        printf '    listen %s ssl;\n' "$nginx_bind"
        [ "$nginx_ipv6" -eq 1 ] && printf '    listen [::]:443 ssl;\n'
        printf '    server_name%s;\n' "$web_hosts"
        printf '    ssl_certificate %s;\n' "$nginx_cert"
        printf '    ssl_certificate_key %s;\n' "$nginx_key"
        cat <<'EOF'
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 2m;

    location / {
        proxy_pass http://telemt_web_managed;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $telemt_connection_upgrade;

        proxy_connect_timeout 5s;
        proxy_send_timeout 65s;
        proxy_read_timeout 65s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_next_upstream off;
    }
}
EOF
    } > "$out" || return 1
    chmod 600 "$out"
}

nginx_prepare_conf() {
    eval "$("$NGINX_UTIL" get_env 2>/dev/null)" || return 1
    [ -n "${UCI_CONF:-}" ] || UCI_CONF=/etc/nginx/uci.conf
    [ -n "${NGINX_CONF:-}" ] || NGINX_CONF=/etc/nginx/nginx.conf

    mkdir -p /var/log/nginx /var/lib/nginx /etc/nginx/conf.d || return 1
    if [ -L "$UCI_CONF" ]; then
        local target
        target=$(readlink "$UCI_CONF" 2>/dev/null || true)
        [ -z "$target" ] || rm -f "$target"
    fi
    "$NGINX_UTIL" init_lan >/dev/null 2>&1 || return 1

    if [ -e "$UCI_CONF" ]; then
        NGINX_ACTIVE_CONF="$UCI_CONF"
    else
        NGINX_ACTIVE_CONF="$NGINX_CONF"
    fi
    [ -f "$NGINX_ACTIVE_CONF" ] || [ -L "$NGINX_ACTIVE_CONF" ] || return 1
}

nginx_test_current() {
    local require_marker="${1:-1}" out
    nginx_prepare_conf || { printf 'ERROR: cannot prepare OpenWrt NGINX configuration\n' >&2; return 1; }
    out=$("$NGINX_BIN" -T -c "$NGINX_ACTIVE_CONF" -g 'daemon off;' 2>&1) || {
        printf '%s\n' "$out" >&2
        return 1
    }
    if [ "$require_marker" -eq 1 ] && ! printf '%s\n' "$out" | grep -qF "$MARKER"; then
        printf 'ERROR: %s is not included by the active OpenWrt NGINX configuration\n' "$FRAGMENT" >&2
        return 1
    fi
    return 0
}

install_firewall_rule() {
    [ "$nginx_auto_fw" -eq 1 ] || return 0
    uci -q batch <<'EOF'
delete firewall.telemt_web_https
set firewall.telemt_web_https=rule
set firewall.telemt_web_https.name='Allow-Telemt-WEB-HTTPS'
set firewall.telemt_web_https.src='wan'
set firewall.telemt_web_https.proto='tcp'
set firewall.telemt_web_https.dest_port='443'
set firewall.telemt_web_https.target='ACCEPT'
EOF
    uci commit firewall || return 1
    /etc/init.d/firewall reload >/dev/null 2>&1 || return 1
}

remove_firewall_rule() {
    if uci -q get firewall.telemt_web_https >/dev/null 2>&1; then
        uci -q delete firewall.telemt_web_https
        uci commit firewall || return 1
        /etc/init.d/firewall reload >/dev/null 2>&1 || return 1
    fi
}

reload_nginx() {
    if pidof nginx >/dev/null 2>&1; then
        "$NGINX_INIT" reload >/dev/null 2>&1 || return 1
    else
        "$NGINX_INIT" enable >/dev/null 2>&1 || true
        "$NGINX_INIT" start >/dev/null 2>&1 || return 1
    fi
    sleep 1
    pidof nginx >/dev/null 2>&1
}

acquire_lock() {
    if ! mkdir "$LOCKDIR" 2>/dev/null; then
        die 'another managed NGINX operation is in progress'
    fi
    trap 'rm -rf "$LOCKDIR"' 0 1 2 15
}

restore_previous_fragment() {
    local had_old="$1" old="$2"
    if [ "$had_old" -eq 1 ]; then
        cp -p "$old" "$FRAGMENT" || return 1
    else
        rm -f "$FRAGMENT"
    fi
}

cmd_render() {
    load_config
    require_nginx_ssl
    validate_frontend_config
    local tmp
    tmp=$(mktemp /tmp/telemt-nginx-render.XXXXXX) || die 'mktemp failed'
    render_cfg "$tmp" || { rm -f "$tmp"; die 'render failed'; }
    cat "$tmp"
    rm -f "$tmp"
}

cmd_check() {
    load_config
    require_nginx_ssl
    validate_frontend_config
    check_bind_conflict
    acquire_lock

    local old new had_old=0 rc=0
    old=$(mktemp /tmp/telemt-nginx-old.XXXXXX) || die 'mktemp failed'
    new=$(mktemp /etc/nginx/conf.d/.telemt-web.XXXXXX) || { rm -f "$old"; die 'mktemp failed'; }
    if [ -f "$FRAGMENT" ]; then
        cp -p "$FRAGMENT" "$old" || { rm -f "$old" "$new"; die 'cannot stage current fragment'; }
        had_old=1
    fi
    render_cfg "$new" || { rm -f "$old" "$new"; die 'render failed'; }
    mv -f "$new" "$FRAGMENT" || { rm -f "$old" "$new"; die 'cannot stage candidate fragment'; }
    nginx_test_current 1 || rc=1
    restore_previous_fragment "$had_old" "$old" || rc=1
    rm -f "$old"
    [ "$rc" -eq 0 ] || die 'NGINX rejected the generated Telemt fragment'
    log 'OK: generated NGINX configuration is valid and included by OpenWrt'
}

cmd_apply() {
    load_config
    require_nginx_ssl
    validate_frontend_config
    [ "$nginx_managed" -eq 1 ] || die 'nginx_managed must be 1 before apply; no NGINX files were changed'
    check_bind_conflict
    acquire_lock

    local old new had_old=0
    old=$(mktemp /tmp/telemt-nginx-rollback.XXXXXX) || die 'mktemp failed'
    new=$(mktemp /etc/nginx/conf.d/.telemt-web.XXXXXX) || { rm -f "$old"; die 'mktemp failed'; }

    if [ -f "$FRAGMENT" ]; then
        cp -p "$FRAGMENT" "$old" || { rm -f "$old" "$new"; die 'cannot create rollback copy'; }
        had_old=1
        if ! grep -qF "$MARKER" "$FRAGMENT" 2>/dev/null && [ ! -e "$FRAGMENT_BACKUP" ]; then
            cp -p "$FRAGMENT" "$FRAGMENT_BACKUP" || { rm -f "$old" "$new"; die 'cannot back up existing Telemt fragment path'; }
            chmod 600 "$FRAGMENT_BACKUP" 2>/dev/null || true
            log "Saved pre-existing fragment to $FRAGMENT_BACKUP"
        fi
    fi

    render_cfg "$new" || { rm -f "$old" "$new"; die 'render failed'; }
    mv -f "$new" "$FRAGMENT" || { rm -f "$old" "$new"; die 'cannot install candidate fragment'; }
    if ! nginx_test_current 1; then
        restore_previous_fragment "$had_old" "$old" >/dev/null 2>&1 || true
        rm -f "$old"
        die 'NGINX rejected generated configuration; previous fragment restored'
    fi

    if ! install_firewall_rule || ! reload_nginx; then
        log 'Managed NGINX activation failed; rolling back' >&2
        remove_firewall_rule >/dev/null 2>&1 || true
        restore_previous_fragment "$had_old" "$old" >/dev/null 2>&1 || true
        nginx_test_current 0 >/dev/null 2>&1 && reload_nginx >/dev/null 2>&1 || true
        rm -f "$old"
        die 'NGINX apply failed and previous fragment was restored where possible'
    fi

    rm -f "$old"
    log "OK: managed NGINX active on ${nginx_bind} -> ${web_ip}:${web_port}"
    [ "$nginx_ipv6" -eq 1 ] && log 'OK: managed NGINX also listens on [::]:443'
    [ "$nginx_auto_fw" -eq 1 ] && log 'OK: managed WAN TCP/443 firewall rule is active'
}

cmd_restore() {
    require_nginx_ssl
    acquire_lock

    local old had_old=0 changed=0
    old=$(mktemp /tmp/telemt-nginx-restore-rollback.XXXXXX) || die 'mktemp failed'
    if [ -f "$FRAGMENT" ]; then
        cp -p "$FRAGMENT" "$old" || { rm -f "$old"; die 'cannot create rollback copy'; }
        had_old=1
    fi

    if [ -f "$FRAGMENT_BACKUP" ]; then
        cp -p "$FRAGMENT_BACKUP" "$FRAGMENT" || { rm -f "$old"; die 'cannot restore saved fragment'; }
        changed=1
    elif grep -qF "$MARKER" "$FRAGMENT" 2>/dev/null; then
        rm -f "$FRAGMENT"
        changed=1
    else
        rm -f "$old"
        die 'no Telemt-managed NGINX fragment or saved pre-Telemt fragment found'
    fi

    if ! nginx_test_current 0; then
        restore_previous_fragment "$had_old" "$old" >/dev/null 2>&1 || true
        rm -f "$old"
        die 'restored NGINX state is invalid; current fragment put back'
    fi

    if ! remove_firewall_rule || ! reload_nginx; then
        restore_previous_fragment "$had_old" "$old" >/dev/null 2>&1 || true
        nginx_test_current 0 >/dev/null 2>&1 && reload_nginx >/dev/null 2>&1 || true
        rm -f "$old"
        die 'NGINX restore failed; previous state put back where possible'
    fi

    rm -f "$old"
    [ "$changed" -eq 1 ] && log 'OK: Telemt managed NGINX frontend was restored/removed'
}

cmd_status() {
    load_config
    printf 'Telemt managed NGINX status\n'
    printf '  web_enabled: %s\n' "$web_enabled"
    printf '  tls_frontend: %s\n' "$tls_terminator"
    printf '  managed: %s\n' "$nginx_managed"
    printf '  bind: %s\n' "$nginx_bind"
    printf '  ipv6: %s\n' "$nginx_ipv6"
    printf '  backend: %s:%s\n' "$web_ip" "$web_port"
    printf '  enabled_vhosts: %s\n' "$web_host_count"
    if [ -f "$FRAGMENT" ] && grep -qF "$MARKER" "$FRAGMENT" 2>/dev/null; then
        printf '  fragment: managed\n'
    elif [ -f "$FRAGMENT" ]; then
        printf '  fragment: existing-unmanaged\n'
    else
        printf '  fragment: absent\n'
    fi
    [ -f "$FRAGMENT_BACKUP" ] && printf '  backup: present\n' || printf '  backup: absent\n'
    pidof nginx >/dev/null 2>&1 && printf '  process: running\n' || printf '  process: stopped\n'
}

usage() {
    cat <<'EOF'
Usage: telemt-web-nginx <status|render|check|apply|restore>
  status   Show UCI, fragment and process state.
  render   Print the candidate managed NGINX fragment without installing it.
  check    Temporarily stage the fragment and validate it with the active OpenWrt NGINX config.
  apply    Install the owned fragment, open WAN TCP/443 if enabled, and reload/start NGINX.
  restore  Restore a pre-existing fragment or remove the Telemt-managed fragment.
EOF
}

case "${1:-status}" in
    status) cmd_status ;;
    render) cmd_render ;;
    check) cmd_check ;;
    apply) cmd_apply ;;
    restore) cmd_restore ;;
    *) usage; exit 2 ;;
esac
