#!/bin/sh
# Telemt WEB managed frontend helper.
# LAB-3: dedicated HAProxy mode. UCI remains the source of truth.

. /lib/functions.sh

HAPROXY_BIN=/usr/sbin/haproxy
HAPROXY_CFG=/etc/haproxy.cfg
HAPROXY_BACKUP=/etc/haproxy.cfg.telemt-backup
RUNTIME_PEM=/var/etc/telemt-haproxy.pem
LOCKDIR=/tmp/telemt-web-haproxy.lock
MARKER='# TELEMT-MANAGED-HAPROXY v1'

log() { printf '%s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

is_uint() {
    [ -n "$1" ] && echo "$1" | grep -qE '^[0-9]+$'
}

load_config() {
    config_load telemt
    config_get_bool web_enabled web enabled 0
    config_get tls_terminator web tls_terminator external
    config_get_bool haproxy_managed web haproxy_managed 0
    config_get haproxy_bind web haproxy_bind ':443'
    config_get haproxy_cert web haproxy_cert ''
    config_get haproxy_key web haproxy_key ''
    config_get_bool haproxy_auto_fw web haproxy_auto_fw 1
    config_get_bool web_listener_enabled web_listener enabled 1
    config_get web_ip web_listener ip '127.0.0.1'
    config_get web_port web_listener port '18080'

    web_hosts=''
    web_host_count=0
    web_host_error=0
    trusted_loopback=0

    collect_host() {
        local s="$1" en host
        config_get_bool en "$s" enabled 1
        [ "$en" -eq 1 ] || return 0
        config_get host "$s" host ''
        if ! echo "$host" | grep -qE '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' || ! echo "$host" | grep -q '\.'; then
            printf "ERROR: enabled WEB vhost '%s' has invalid FQDN '%s'\n" "$s" "$host" >&2
            web_host_error=1
            return 0
        fi
        host=$(echo "$host" | tr 'A-Z' 'a-z')
        web_hosts="${web_hosts} ${host} ${host}:443"
        web_host_count=$((web_host_count + 1))
    }

    check_trusted_proxy() {
        [ "$1" = '127.0.0.1/32' ] && trusted_loopback=1
    }

    config_foreach collect_host web_vhost
    config_list_foreach web_listener trusted_proxy_cidr check_trusted_proxy
}

require_haproxy_ssl() {
    [ -x "$HAPROXY_BIN" ] || die "SSL-capable OpenWrt package 'haproxy' is not installed"
    "$HAPROXY_BIN" -vv 2>/dev/null | grep -q 'Built with OpenSSL version' || \
        die "HAProxy has no OpenSSL support; haproxy-nossl cannot terminate WEB TLS"
}

validate_frontend_config() {
    [ "$web_enabled" -eq 1 ] || die 'telemt.web.enabled must be 1'
    [ "$tls_terminator" = 'haproxy' ] || die "telemt.web.tls_terminator must be 'haproxy'"
    [ "$web_listener_enabled" -eq 1 ] || die 'WEB backend listener is disabled'
    [ "$web_ip" = '127.0.0.1' ] || die 'managed HAProxy requires WEB backend on 127.0.0.1'
    is_uint "$web_port" && [ "$web_port" -ge 1 ] && [ "$web_port" -le 65535 ] || \
        die "invalid WEB backend port '$web_port'"
    [ "$trusted_loopback" -eq 1 ] || die 'web_listener must trust 127.0.0.1/32 for managed HAProxy'
    [ "$web_host_error" -eq 0 ] || die 'one or more enabled WEB vhosts are invalid'
    [ "$web_host_count" -gt 0 ] || die 'at least one enabled WEB vhost with a valid FQDN is required'

    echo "$haproxy_bind" | grep -qE '^:443$|^0\.0\.0\.0:443$|^([0-9]{1,3}\.){3}[0-9]{1,3}:443$|^\[[0-9A-Fa-f:]+\]:443$' || \
        die "haproxy_bind must be a concrete address on TCP/443 or ':443'"

    [ -n "$haproxy_cert" ] || die 'haproxy_cert is empty'
    echo "$haproxy_cert" | grep -qE '^/[A-Za-z0-9._/@+-]+$' || die 'haproxy_cert contains unsupported path characters'
    [ -f "$haproxy_cert" ] || die "certificate file not found: $haproxy_cert"
    if [ -n "$haproxy_key" ]; then
        echo "$haproxy_key" | grep -qE '^/[A-Za-z0-9._/@+-]+$' || die 'haproxy_key contains unsupported path characters'
        [ -f "$haproxy_key" ] || die "private key file not found: $haproxy_key"
    fi
}

check_bind_conflict() {
    local lines='' other=''
    if command -v ss >/dev/null 2>&1; then
        lines=$(ss -lntp 2>/dev/null | grep -E '(:|\])443[[:space:]]' || true)
    elif command -v netstat >/dev/null 2>&1; then
        lines=$(netstat -lntp 2>/dev/null | grep -E '(:|\])443[[:space:]]' || true)
    fi
    [ -z "$lines" ] && return 0
    other=$(printf '%s\n' "$lines" | grep -vi haproxy || true)
    [ -z "$other" ] && return 0
    printf '%s\n' "$other" >&2
    die 'TCP/443 is already occupied by a non-HAProxy listener; resolve uhttpd/NGINX/other conflict first'
}

prepare_pem() {
    local out="$1"
    umask 077
    if [ -n "$haproxy_key" ]; then
        cat "$haproxy_cert" "$haproxy_key" > "$out" || return 1
    else
        cat "$haproxy_cert" > "$out" || return 1
    fi
    chmod 600 "$out"
}

render_cfg() {
    local out="$1" pem="$2"
    umask 077
    cat > "$out" <<EOF
$MARKER
# Generated from /etc/config/telemt. Do not edit this file in managed mode.
# Bearer-bearing HTTP requests are intentionally not access-logged.

global
    maxconn 4096

defaults
    mode http
    timeout connect 5s
    timeout client 65s
    timeout server 65s
    timeout tunnel 65s
    timeout check 5s

frontend telemt_web_https
    mode http
    bind ${haproxy_bind} ssl crt ${pem} alpn h2,http/1.1 ssl-min-ver TLSv1.2
    acl telemt_web_host hdr(host) -i${web_hosts}
    use_backend telemt_web if telemt_web_host

backend telemt_web
    mode http
    option http-keep-alive
    retries 0
    timeout connect 5s
    timeout server 65s
    http-request del-header X-Forwarded-For
    http-request set-header X-Forwarded-For %[src]
    server telemt_web_1 ${web_ip}:${web_port} check
EOF
    chmod 600 "$out"
}

check_cfg() {
    "$HAPROXY_BIN" -c -q -V -f "$1"
}

install_firewall_rule() {
    [ "$haproxy_auto_fw" -eq 1 ] || return 0
    uci -q batch <<'EOF'
delete firewall.telemt_web_https
set firewall.telemt_web_https=rule
set firewall.telemt_web_https.name='Allow-Telemt-WEB-HTTPS'
set firewall.telemt_web_https.src='wan'
set firewall.telemt_web_https.proto='tcp'
set firewall.telemt_web_https.dest_port='443'
set firewall.telemt_web_https.target='ACCEPT'
EOF
    uci commit firewall || return 1
    /etc/init.d/firewall reload >/dev/null 2>&1 || return 1
}

remove_firewall_rule() {
    if uci -q get firewall.telemt_web_https >/dev/null 2>&1; then
        uci -q delete firewall.telemt_web_https
        uci commit firewall || return 1
        /etc/init.d/firewall reload >/dev/null 2>&1 || return 1
    fi
}

reload_haproxy() {
    [ -x /etc/init.d/haproxy ] || die '/etc/init.d/haproxy is missing'
    /etc/init.d/haproxy enable >/dev/null 2>&1 || true
    if pidof haproxy >/dev/null 2>&1; then
        /etc/init.d/haproxy force_reload >/dev/null 2>&1 || return 1
    else
        /etc/init.d/haproxy start >/dev/null 2>&1 || return 1
    fi
    sleep 1
    pidof haproxy >/dev/null 2>&1
}

acquire_lock() {
    if ! mkdir "$LOCKDIR" 2>/dev/null; then
        die 'another managed HAProxy operation is in progress'
    fi
    trap 'rm -rf "$LOCKDIR"' 0 1 2 15
}

cmd_render() {
    load_config
    require_haproxy_ssl
    validate_frontend_config
    local tmp
    tmp=$(mktemp /tmp/telemt-haproxy-render.XXXXXX) || die 'mktemp failed'
    render_cfg "$tmp" "$haproxy_cert" || { rm -f "$tmp"; die 'render failed'; }
    cat "$tmp"
    rm -f "$tmp"
}

cmd_check() {
    load_config
    require_haproxy_ssl
    validate_frontend_config
    check_bind_conflict
    local tmp_pem tmp_cfg
    tmp_pem=$(mktemp /tmp/telemt-haproxy-pem.XXXXXX) || die 'mktemp failed'
    tmp_cfg=$(mktemp /tmp/telemt-haproxy-cfg.XXXXXX) || { rm -f "$tmp_pem"; die 'mktemp failed'; }
    prepare_pem "$tmp_pem" || { rm -f "$tmp_pem" "$tmp_cfg"; die 'cannot build certificate bundle'; }
    render_cfg "$tmp_cfg" "$tmp_pem" || { rm -f "$tmp_pem" "$tmp_cfg"; die 'render failed'; }
    if ! check_cfg "$tmp_cfg"; then
        rm -f "$tmp_pem" "$tmp_cfg"
        die 'HAProxy rejected generated configuration'
    fi
    rm -f "$tmp_pem" "$tmp_cfg"
    log 'OK: generated HAProxy configuration is valid'
}

cmd_apply() {
    load_config
    require_haproxy_ssl
    validate_frontend_config
    [ "$haproxy_managed" -eq 1 ] || die 'haproxy_managed must be 1 before apply; existing /etc/haproxy.cfg was not touched'
    check_bind_conflict
    acquire_lock

    mkdir -p /var/etc || die 'cannot create /var/etc'
    local tmp_pem tmp_cfg rollback rollback_pem had_live=0 had_pem=0
    tmp_pem="${RUNTIME_PEM}.tmp.$$"
    tmp_cfg=$(mktemp /etc/.haproxy.cfg.telemt.XXXXXX) || die 'mktemp failed'
    rollback=$(mktemp /tmp/haproxy.cfg.rollback.XXXXXX) || { rm -f "$tmp_cfg"; die 'mktemp failed'; }
    rollback_pem=$(mktemp /tmp/telemt-haproxy.pem.rollback.XXXXXX) || { rm -f "$tmp_cfg" "$rollback"; die 'mktemp failed'; }

    prepare_pem "$tmp_pem" || { rm -f "$tmp_pem" "$tmp_cfg" "$rollback" "$rollback_pem"; die 'cannot build certificate bundle'; }
    render_cfg "$tmp_cfg" "$tmp_pem" || { rm -f "$tmp_pem" "$tmp_cfg" "$rollback" "$rollback_pem"; die 'render failed'; }
    check_cfg "$tmp_cfg" || { rm -f "$tmp_pem" "$tmp_cfg" "$rollback" "$rollback_pem"; die 'HAProxy rejected generated configuration'; }

    if [ -f "$HAPROXY_CFG" ]; then
        had_live=1
        cp -p "$HAPROXY_CFG" "$rollback" || { rm -f "$tmp_pem" "$tmp_cfg" "$rollback" "$rollback_pem"; die 'cannot create rollback copy'; }
        if ! grep -qF "$MARKER" "$HAPROXY_CFG" 2>/dev/null && [ ! -e "$HAPROXY_BACKUP" ]; then
            cp -p "$HAPROXY_CFG" "$HAPROXY_BACKUP" || { rm -f "$tmp_pem" "$tmp_cfg" "$rollback" "$rollback_pem"; die 'cannot back up existing /etc/haproxy.cfg'; }
            chmod 600 "$HAPROXY_BACKUP" 2>/dev/null || true
            log "Saved original HAProxy config to $HAPROXY_BACKUP"
        fi
    fi
    if [ -f "$RUNTIME_PEM" ]; then
        had_pem=1
        cp -p "$RUNTIME_PEM" "$rollback_pem" || { rm -f "$tmp_pem" "$tmp_cfg" "$rollback" "$rollback_pem"; die 'cannot back up runtime PEM'; }
    fi

    mv -f "$tmp_pem" "$RUNTIME_PEM" || { rm -f "$tmp_cfg" "$rollback" "$rollback_pem"; die 'cannot install runtime PEM'; }
    render_cfg "$tmp_cfg" "$RUNTIME_PEM" || { rm -f "$tmp_cfg" "$rollback" "$rollback_pem"; die 'render failed'; }
    check_cfg "$tmp_cfg" || { rm -f "$tmp_cfg" "$rollback" "$rollback_pem"; die 'HAProxy rejected final managed configuration'; }
    mv -f "$tmp_cfg" "$HAPROXY_CFG" || { rm -f "$rollback" "$rollback_pem"; die 'cannot install managed HAProxy config'; }
    chmod 600 "$HAPROXY_CFG"

    if ! install_firewall_rule || ! reload_haproxy; then
        log 'Managed HAProxy activation failed; rolling back' >&2
        remove_firewall_rule >/dev/null 2>&1 || true
        if [ "$had_live" -eq 1 ] && [ -s "$rollback" ]; then
            cp -p "$rollback" "$HAPROXY_CFG"
        else
            rm -f "$HAPROXY_CFG"
        fi
        if [ "$had_pem" -eq 1 ] && [ -s "$rollback_pem" ]; then
            cp -p "$rollback_pem" "$RUNTIME_PEM"
        else
            rm -f "$RUNTIME_PEM"
        fi
        if [ "$had_live" -eq 1 ] && pidof haproxy >/dev/null 2>&1; then
            /etc/init.d/haproxy force_reload >/dev/null 2>&1 || true
        fi
        rm -f "$rollback" "$rollback_pem"
        die 'HAProxy apply failed and previous state was restored where possible'
    fi

    rm -f "$rollback" "$rollback_pem"
    log "OK: managed HAProxy active on ${haproxy_bind} -> ${web_ip}:${web_port}"
    [ "$haproxy_auto_fw" -eq 1 ] && log 'OK: managed WAN TCP/443 firewall rule is active'
}

cmd_restore() {
    load_config
    require_haproxy_ssl
    acquire_lock
    [ -f "$HAPROXY_BACKUP" ] || die "no backup found at $HAPROXY_BACKUP"

    local tmp
    tmp=$(mktemp /etc/.haproxy.cfg.restore.XXXXXX) || die 'mktemp failed'
    cp -p "$HAPROXY_BACKUP" "$tmp" || { rm -f "$tmp"; die 'cannot stage backup'; }
    check_cfg "$tmp" || { rm -f "$tmp"; die 'saved HAProxy backup is not valid with the installed HAProxy'; }
    mv -f "$tmp" "$HAPROXY_CFG" || die 'cannot restore HAProxy config'
    remove_firewall_rule || die 'config restored but firewall cleanup failed'

    if pidof haproxy >/dev/null 2>&1; then
        /etc/init.d/haproxy force_reload >/dev/null 2>&1 || die 'config restored but HAProxy reload failed'
    else
        /etc/init.d/haproxy start >/dev/null 2>&1 || die 'config restored but HAProxy start failed'
    fi
    rm -f "$RUNTIME_PEM"
    log "OK: restored $HAPROXY_BACKUP to $HAPROXY_CFG"
}

cmd_status() {
    load_config
    printf 'Telemt managed HAProxy status\n'
    printf '  web_enabled: %s\n' "$web_enabled"
    printf '  tls_terminator: %s\n' "$tls_terminator"
    printf '  managed: %s\n' "$haproxy_managed"
    printf '  bind: %s\n' "$haproxy_bind"
    printf '  backend: %s:%s\n' "$web_ip" "$web_port"
    printf '  enabled_vhosts: %s\n' "$web_host_count"
    printf '  haproxy_binary: %s\n' "$([ -x "$HAPROXY_BIN" ] && echo present || echo missing)"
    if [ -x "$HAPROXY_BIN" ] && "$HAPROXY_BIN" -vv 2>/dev/null | grep -q 'Built with OpenSSL version'; then
        printf '  ssl_support: yes\n'
    else
        printf '  ssl_support: no\n'
    fi
    printf '  live_config: %s\n' "$([ -f "$HAPROXY_CFG" ] && grep -qF "$MARKER" "$HAPROXY_CFG" 2>/dev/null && echo telemt-managed || echo external)"
    printf '  backup: %s\n' "$([ -f "$HAPROXY_BACKUP" ] && echo present || echo absent)"
    printf '  process: %s\n' "$(pidof haproxy >/dev/null 2>&1 && echo running || echo stopped)"
    printf '  firewall_443: %s\n' "$(uci -q get firewall.telemt_web_https >/dev/null 2>&1 && echo managed || echo absent)"
}

usage() {
    cat <<'EOF'
Usage: telemt-web-frontend <status|render|check|apply|restore>

  status   Read current UCI/HAProxy state. No writes.
  render   Print the generated dedicated HAProxy config. No writes.
  check    Build a temporary PEM/config and validate with haproxy -c. No live writes.
  apply    With tls_terminator=haproxy and haproxy_managed=1, atomically own
           /etc/haproxy.cfg, keep one backup, manage optional WAN/443 rule, reload.
  restore  Restore the saved pre-Telemt HAProxy config and remove our firewall rule.
EOF
}

case "${1:-status}" in
    status) cmd_status ;;
    render) cmd_render ;;
    check) cmd_check ;;
    apply) cmd_apply ;;
    restore) cmd_restore ;;
    *) usage; exit 2 ;;
esac
