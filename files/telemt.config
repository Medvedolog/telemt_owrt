# Default UCI Configuration for Telemt MTProxy (Headless Core) - v3.5.6 branch
# This file provides fallback values for the headless core and LuCI WebUI.
# /etc/config/telemt is the persistent source of truth; runtime TOML is generated by init.d.

config telemt 'general'
	option enabled '0'
	option port '8443'
	option public_port ''
	option api_port '9091'
	option metrics_port '9092'
	# Control-plane bind addresses. 127.0.0.1 = loopback only (safe default).
	# Set 0.0.0.0 to expose on LAN (whitelist becomes the only access guard).
	option metrics_listen_addr '127.0.0.1'
	option api_listen_addr '127.0.0.1'
	
	# Unified Control-Plane Switch (Replaces api_enabled & minimal_runtime_enabled)
	option extended_runtime_enabled '1'
	
	option metrics_allow_lo '1'
	option metrics_allow_lan '1'
	option metrics_whitelist ''
	option mode 'tls'
	option log_level 'normal'
	option domain 'google.com'
	option auto_fw '1'
	option listen_ipv4 '1'
	option listen_ipv6 '0'
	option prefer_ip '4'
	
	option use_middle_proxy '0'
	option use_stun '0'
	
	# Anti-censorship & TLS tuning defaults
	option mask_proxy_protocol '0'
	# 3.4.18+
	option mask_dynamic '1'
	option client_mss ''
	# Self-Stealth: mask_port and mask_host redirect TLS probers to a local server
	option mask_port '443'
	option mask_host ''
	option fake_cert_len '2048'
	option tls_full_cert_ttl_secs '0'
	option replay_window_secs '1800'
	option ignore_time_skew '0'
	option desync_all_full '0'

	# Middle-End proxy limits
	option me_pool_size '16'
	option me_warm_standby '8'
	option hardswap '1'
	option me_drain_ttl '90'
	
	# Middle-End Adaptive Tuning (Hidden under UI spoiler)
					
	# Middle-End Outage Recovery
					
	# Fallback (Replaces auto_degradation_enabled)
	option auto_degradation '1'
	option degradation_min_dc '2'
	
	# Custom user scripts/bot update interval
	option update_every '300'

# -----------------------------------------------------------------------------
# Telemt 3.5.6 WEB Proxy
# Safe upgrade invariant: WEB is disabled by default and therefore does not
# change Classic/DD/FakeTLS behaviour on existing installations.
# -----------------------------------------------------------------------------
config web 'web'
	option enabled '0'
	# fixed = use one carrier; auto negotiation will be added in a later LAB.
	option carrier_policy 'fixed'
	option carrier 'https'
	# OpenWrt abstraction; translated to [web.limits] by a later generator patch.
	option memory_profile 'standard'
	# external | haproxy | nginx. Frontend management is implemented separately.
	option tls_terminator 'external'
	option debug_enabled '0'

# Private plain-HTTP listener behind the TLS terminator.
# It must never be exposed directly to WAN by auto-firewall logic.
config web_listener 'web_listener'
	option enabled '1'
	option ip '127.0.0.1'
	option port '18080'
	option client_ip_source 'x_forwarded_for'
	list trusted_proxy_cidr '127.0.0.1/32'

# Disabled starter vhost. LuCI/uci may create additional sections of type
# web_vhost; the backend will later generate one [[web.vhosts]] per enabled row.
config web_vhost 'web_vhost_default'
	option enabled '0'
	option name 'main'
	option host ''
	option public_addr ''
	option decoy_mode 'http_upstream'
	option decoy_upstream ''

# Disabled starter binding to the shared Telemt user database.
# No secret is stored here: user/secret/quota/expiration stay in config user.
config web_profile 'web_profile_default'
	option enabled '0'
	option vhost 'main'
	option user ''
	option secret_mode 'dd'
