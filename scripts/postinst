#!/bin/sh
# telemt post-install: runs from the package manager on install and upgrade.
#
#   1. stop a stale daemon, retire the pre-UCI /etc/telemt directory
#   2. migrate UCI: metrics/API ports, then the WEB sections (idempotent — only
#      missing sections/options are created, operator values are never overwritten)
#   3. fix permissions, enable and (re)start the service
#
# Nothing here may fail the install, so every external call is guarded.

# Building an image: the target rootfs has no running system to talk to.
[ -z "${IPKG_INSTROOT:-}" ] || exit 0

echo ""
echo "================================================================="
echo " Installed Headless Telemt $(/usr/bin/telemt --version 2>/dev/null | head -n 1)"
echo " Managed by procd via /etc/init.d/telemt"
echo " LuCI package (optional): luci-app-telemt"
echo "================================================================="

if pidof telemt >/dev/null 2>&1; then
    killall -9 telemt 2>/dev/null || true
fi

if [ -d "/etc/telemt" ]; then
    mv /etc/telemt /etc/telemt.disabled_by_luci 2>/dev/null || true
fi

old_metrics="$(uci -q get telemt.general.metrics_port 2>/dev/null || true)"
if [ "$old_metrics" = "9091" ] || [ "$old_metrics" = "9090" ]; then
    uci -q set telemt.general.metrics_port='9092' || true
    uci -q set telemt.general.api_port='9091' || true
    uci -q commit telemt 2>/dev/null || true
fi

set -eu

has_section() {
    uci -q show "telemt.$1" >/dev/null 2>&1
}

ensure_section() {
    section="$1"
    type="$2"
    if ! has_section "$section"; then
        uci -q set "telemt.$section=$type"
    fi
}

ensure_option() {
    section="$1"
    option="$2"
    value="$3"
    if ! uci -q get "telemt.$section.$option" >/dev/null 2>&1; then
        uci -q set "telemt.$section.$option=$value"
    fi
}

ensure_list_value() {
    section="$1"
    option="$2"
    value="$3"
    current="$(uci -q get "telemt.$section.$option" 2>/dev/null || true)"
    case " $current " in
        *" $value "*) ;;
        *) uci -q add_list "telemt.$section.$option=$value" ;;
    esac
}

ensure_section web web
ensure_option web enabled 0
ensure_option web carrier_policy fixed
ensure_option web carrier https
ensure_list_value web carrier_candidate websocket-lanes
ensure_list_value web carrier_candidate websocket
ensure_list_value web carrier_candidate https-lanes
ensure_option web carrier_learning 1
ensure_option web carrier_negotiation_aggressiveness conservative
ensure_option web memory_profile standard
ensure_option web tls_terminator external
ensure_option web haproxy_managed 0
ensure_option web haproxy_bind :443
ensure_option web haproxy_cert ""
ensure_option web haproxy_key ""
ensure_option web haproxy_auto_fw 1
ensure_option web nginx_managed 0
ensure_option web nginx_bind 443
ensure_option web nginx_ipv6 0
ensure_option web nginx_cert ""
ensure_option web nginx_key ""
ensure_option web nginx_auto_fw 1
ensure_option web debug_enabled 0
ensure_option web debug_sideband 0
ensure_option web debug_capture_lifecycle 0

ensure_section web_listener web_listener
ensure_option web_listener enabled 1
ensure_option web_listener ip 127.0.0.1
ensure_option web_listener port 27453
ensure_option web_listener client_ip_source x_forwarded_for
ensure_list_value web_listener trusted_proxy_cidr 127.0.0.1/32

uci -q commit telemt

# Clear LuCI caches so the newly created named WEB section is visible immediately.
rm -f /tmp/luci-indexcache 2>/dev/null || true
rm -f /tmp/luci-modulecache/* 2>/dev/null || true

chmod 0755 /usr/bin/telemt 2>/dev/null || true
chmod 0755 /etc/init.d/telemt 2>/dev/null || true
chmod 0755 /usr/libexec/telemt-web-check 2>/dev/null || true
chmod 0755 /usr/libexec/telemt-web-frontend 2>/dev/null || true
chmod 0755 /usr/libexec/telemt-web-nginx 2>/dev/null || true
chmod 0755 /etc/hotplug.d/acme/95-telemt-web-haproxy 2>/dev/null || true
chmod 0644 /etc/config/telemt 2>/dev/null || true

/etc/init.d/telemt enable 2>/dev/null || true
/etc/init.d/telemt restart 2>/dev/null || /etc/init.d/telemt start 2>/dev/null || true

exit 0
